#!/bin/sh
set -eu

profile="${1:-fast}"
lane="${2:-all}"
if [ "$profile" != "fast" ] && [ "$profile" != "full" ]; then
    echo "usage: tools/quality [fast|full] [all|static|tests|rust|release|coverage]" >&2
    exit 64
fi
case "$lane" in
    all | static | tests | rust | release | coverage) ;;
    *)
        echo "usage: tools/quality [fast|full] [all|static|tests|rust|release|coverage]" >&2
        exit 64
        ;;
esac

# Which lanes a run performs. `all` is the local default and keeps this script
# a single linear gate; CI passes one lane per job so the five run in parallel.
#
# The split is drawn where the work is genuinely independent, and NOT by
# language, because coverage cannot be split that way: tools/coverage runs
# PHPUnit once under pcov and that one run produces the PHP, JavaScript AND
# Python figures, the latter two from worker subprocesses it drives. Splitting
# coverage per language would measure three suites that never run the workers
# and report floors nothing earns.
in_lane() {
    [ "$lane" = "all" ] || [ "$lane" = "$1" ]
}

# scanner-conformance exits 127 on a relative binary path: WorkerProcessSupervisor
# pins the child's working directory to the system temp dir, so a path relative
# to this script's cwd would not resolve there. Derive an absolute root instead
# of assuming this script runs from the repository root.
root=$(unset CDPATH; cd -- "$(dirname -- "$0")/.." && pwd)

# Run the PHPUnit suite, and with it the SessionStart hook's shell-level
# failure-mode tests: `composer test` runs both, because the hook's fail-silent
# contract is a property of a shell script that no PHP test can reach, and a
# check that lives beside the suite without running with it is a check nobody
# runs. In the quality container the tooling is installed as
# root, but the permission-error tests (Doctor unwritable-data-dir, MigrationRunner
# unreadable-migration, ProjectDiscoverer permission-denied) skip themselves when
# the process is root, so those branches would silently never run. Drop to the
# dedicated non-root `knossos` user for the suite; root is still used for the
# Trivy/docker-socket/coverage steps. Outside the container (local dev) run in
# place. HOME is set because the caller's environment is preserved and root's
# HOME is not writable by the non-root user.
run_test_suite() {
    if [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ] && [ "$(id -u)" = "0" ]; then
        runuser -u knossos -- env HOME=/home/knossos composer test
    else
        composer test
    fi
}

if in_lane static; then
composer validate --strict
composer --working-dir=workers/php validate --strict
composer install --dry-run --no-interaction --no-scripts
npm ci --dry-run --ignore-scripts --no-audit --no-fund
npm --prefix workers/typescript ci --dry-run --ignore-scripts --no-audit --no-fund

composer lint
vendor/bin/php-cs-fixer check --using-cache=no --allow-risky=yes --sequential
vendor/bin/phpstan analyse --no-progress --debug --memory-limit=512M
npm run lint:js
npm run format:check
npm run lint:md
# The tests are linted and formatted alongside the worker they exercise: a
# gate that covered only bin/worker.py let workers/python/tests drift out of
# `ruff format` shape with nothing to catch it.
ruff check workers/python/bin/worker.py workers/python/tests
ruff format --check workers/python/bin/worker.py workers/python/tests
mypy workers/python/bin/worker.py
fi

if in_lane tests; then
python3 -m pytest workers/python
fi

if in_lane rust; then
if command -v cargo >/dev/null 2>&1; then
    cargo fmt --manifest-path workers/rust/Cargo.toml --check
    cargo clippy --locked --manifest-path workers/rust/Cargo.toml --all-targets -- -D warnings
    cargo test --locked --manifest-path workers/rust/Cargo.toml
elif [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ]; then
    echo "cargo is required in the quality container" >&2
    exit 1
fi
fi

if in_lane static; then
php tools/repository-check.php
php tools/generate-reference.php --check
php tools/documentation-check.php
php tools/maintainability-report.php
php tools/docstring-report.php
php tools/api-documentation-check.php
fi

if in_lane rust; then
if [ -x "$root/workers/rust/bin/knossos-rust-worker" ]; then
    tools/scanner-conformance --require=partial_ast -- "$root/workers/rust/bin/knossos-rust-worker"
elif [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ]; then
    echo "the Rust worker binary is required in the quality container" >&2
    exit 1
fi
fi
if in_lane tests; then
# The Python worker is mandatory, so its protocol conformance is checked
# unconditionally, not behind an existence probe like the optional Rust one.
tools/scanner-conformance --require=partial_ast -- python3 -I -B "$root/workers/python/bin/worker.py"
fi

if in_lane static; then
if command -v pre-commit >/dev/null 2>&1; then
    pre-commit validate-config .pre-commit-config.yaml
elif [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ]; then
    echo "pre-commit is required in the quality container" >&2
    exit 1
fi

if command -v shellcheck >/dev/null 2>&1; then
    shellcheck tools/quality tools/quality-container tools/install-hooks tools/benchmark \
        tools/mcp-serve tools/mutation-diff tools/release-lifecycle tools/supply-chain tools/install \
        hooks/scripts/session-brief.sh hooks/scripts/session-brief-container.sh \
        tests/shell/session-brief-hook.sh
elif [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ]; then
    echo "shellcheck is required in the quality container" >&2
    exit 1
fi

if command -v hadolint >/dev/null 2>&1; then
    hadolint Dockerfile
elif [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ]; then
    echo "hadolint is required in the quality container" >&2
    exit 1
fi

if command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
    KNOSSOS_HTTP_BEARER_TOKEN=quality-gate-placeholder docker compose config --quiet
elif [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ]; then
    echo "docker compose is required in the quality container" >&2
    exit 1
fi
fi

if in_lane tests; then
npm --prefix workers/typescript run check
run_test_suite
fi

if [ "$profile" = "full" ] && in_lane release; then
    composer audit --locked --no-interaction
    npm audit --audit-level=high
    npm --prefix workers/typescript audit --audit-level=high
    if command -v cargo-audit >/dev/null 2>&1; then
        cargo audit --file workers/rust/Cargo.lock
    elif [ "${KNOSSOS_QUALITY_CONTAINER:-0}" = "1" ]; then
        echo "cargo-audit is required in the quality container" >&2
        exit 1
    fi
    # Skipped where a failure would block rather than inform. This check asks
    # whether a web server is answering right now, which is not a property of
    # the change under review. A pull request touching only documentation
    # failed the gate while the site the README badge points at was mid-deploy,
    # and it was our own site: a link check on the critical path turns every
    # deploy anywhere into a red build here. Internal link checking is not
    # affected, it runs in the static lane and is entirely ours to keep true.
    if [ "${KNOSSOS_EXTERNAL_LINKS:-1}" = "1" ]; then
        php tools/documentation-check.php --external
    fi
    npm_config_cache=/tmp/knossos-inspector-cache npx -y @modelcontextprotocol/inspector@0.21.2 --cli \
        php /opt/knossos/bin/knossos serve --allow-root=/opt/knossos \
        --db=/tmp/knossos-inspector.sqlite --method tools/list
    # Built only when it is not already here. CI builds this target in its
    # own job, through buildx against a layer cache, and loads it into the
    # daemon before the lane starts; rebuilding it here would throw that away
    # and pay for an uncached build inside the container. Locally the image is
    # usually absent, so the build still happens on a workstation.
    if ! docker image inspect knossos-mcp:quality-runtime >/dev/null 2>&1; then
        docker build --target runtime -t knossos-mcp:quality-runtime .
    fi
    docker run --rm knossos-mcp:quality-runtime doctor --json
    tools/release-lifecycle
    tools/supply-chain
    tools/benchmark
fi

# Coverage is its own lane because it re-runs the whole PHPUnit suite under
# pcov. That second run already happened serially after the first; giving it a
# lane lets the two run side by side instead.
if [ "$profile" = "full" ] && in_lane coverage; then
    # Mutation testing is deliberately NOT part of any profile: a full-src
    # Infection run takes over an hour, which is far too slow to gate a push.
    # Run it on demand instead -- `.github/workflows/mutation.yml`
    # (workflow_dispatch), or locally per docs/development/adversarial-testing.md.
    tools/coverage
fi
