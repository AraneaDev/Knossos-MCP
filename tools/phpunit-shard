#!/usr/bin/env php
<?php

declare(strict_types=1);

/*
 * Splits the PHPUnit suite into N shards for CI's coverage jobs.
 *
 *   tools/phpunit-shard --shard=I/N --out=PATH [--files-from=PATH] [--weights=PATH]
 *       writes a PHPUnit config that runs shard I of N: phpunit.xml with its
 *       test suite replaced by that shard's files.
 *   tools/phpunit-shard --list=N [--files-from=PATH] [--weights=PATH]
 *       prints every test file with the shard it belongs to, `file<TAB>shard`,
 *       which is what tools/coverage-merge.php checks the shards' JUnit logs
 *       against.
 *   tools/phpunit-shard --weigh JUNIT...
 *       prints the per-file times of the given JUnit logs as a weights file,
 *       the shape of tests/phpunit-shard-weights.json.
 *
 * The files are those PHPUnit lists tests in (`--list-tests-xml`), or the
 * lines of a list file when one is given. A `*Test.php` that holds no runnable
 * test, such as an abstract base class, is not one of them: it never shows up
 * in a JUnit log, so expecting it there would make the merge refuse a
 * complete run. --config names another PHPUnit config to list and copy from
 * than phpunit.xml. Each weighs its measured time
 * from the weights file (tests/phpunit-shard-weights.json unless --weights
 * names another); a file the weights do not know weighs their median. The
 * heaviest file goes first, each to the shard with the least weight so far,
 * ties broken by name and then by the lower shard. Dealt out by name alone,
 * four shards were measured at 72, 78, 162 and 109 s: the TypeScript worker
 * tests sit next to each other and dominate the suite, and round-robin put
 * the largest of them in one shard. With every weight equal, as without a
 * weights file, this is round-robin over the sorted names.
 *
 * The assignment depends only on the file names and the weights file, both
 * part of the commit, so every runner computes the same one.
 *
 * Paths in the generated config are absolute, because PHPUnit resolves a
 * relative path against the directory the config file is in, and the config is
 * written outside the repository root.
 */

$root = dirname(__DIR__);

function shardFail(string $message): never
{
    fwrite(STDERR, "phpunit-shard: {$message}\n");
    fwrite(STDERR, "usage: tools/phpunit-shard --shard=I/N --out=PATH [--files-from=PATH]\n");
    fwrite(STDERR, "       tools/phpunit-shard --list=N [--files-from=PATH]\n");
    exit(64);
}

$shard = null;
$count = null;
$list = null;
$out = null;
$filesFrom = null;
$weightsFrom = $root . '/tests/phpunit-shard-weights.json';
$weigh = null;
$config = $root . '/phpunit.xml';
foreach (array_slice($argv, 1) as $argument) {
    if ($weigh !== null) {
        $weigh[] = $argument;
    } elseif ($argument === '--weigh') {
        $weigh = [];
    } elseif (str_starts_with($argument, '--config=') && strlen($argument) > 9) {
        $config = substr($argument, 9);
    } elseif (str_starts_with($argument, '--weights=') && strlen($argument) > 10) {
        $weightsFrom = substr($argument, 10);
    } elseif (preg_match('/^--shard=(\d+)\/(\d+)$/', $argument, $match) === 1) {
        [$shard, $count] = [(int) $match[1], (int) $match[2]];
    } elseif (preg_match('/^--list=(\d+)$/', $argument, $match) === 1) {
        $list = (int) $match[1];
    } elseif (str_starts_with($argument, '--out=') && strlen($argument) > 6) {
        $out = substr($argument, 6);
    } elseif (str_starts_with($argument, '--files-from=') && strlen($argument) > 13) {
        $filesFrom = substr($argument, 13);
    } else {
        shardFail("unknown argument {$argument}");
    }
}
if ($weigh !== null) {
    if ($weigh === [] || $shard !== null || $list !== null) {
        shardFail('--weigh takes one or more JUnit logs and nothing else');
    }
    $times = [];
    foreach ($weigh as $junit) {
        $document = new DOMDocument();
        if (!@$document->load($junit)) {
            shardFail("cannot read {$junit}");
        }
        // Only the outermost suite of a file: a data provider nests suites
        // carrying the same file, and counting those too would weigh it twice.
        foreach ((new DOMXPath($document))->query('//testsuite[@file][not(ancestor::testsuite[@file])]') ?: [] as $suite) {
            if ($suite instanceof DOMElement) {
                $file = preg_replace('#^.*?/(tests/phpunit/)#', '$1', $suite->getAttribute('file'));
                $times[$file] = ($times[$file] ?? 0.0) + (float) $suite->getAttribute('time');
            }
        }
    }
    uksort($times, strcmp(...));
    $lines = [];
    foreach ($times as $file => $seconds) {
        $lines[] = sprintf('  %s: %.1f', json_encode($file, JSON_UNESCAPED_SLASHES | JSON_THROW_ON_ERROR), max(0.1, $seconds));
    }
    echo "{\n", implode(",\n", $lines), "\n}\n";
    exit(0);
}
if (($shard === null) === ($list === null)) {
    shardFail('pass exactly one of --shard=I/N and --list=N');
}
if ($list !== null && $list < 1) {
    shardFail('--list needs a shard count of at least 1');
}
if ($shard !== null && ($count < 1 || $shard < 1 || $shard > $count)) {
    shardFail("--shard={$shard}/{$count} is not a shard of 1..N");
}
if ($shard !== null && $out === null) {
    shardFail('--shard needs --out=PATH');
}

/**
 * The suite's test files, relative to the repository root.
 *
 * @return list<string>
 */
function shardTestFiles(string $root, ?string $filesFrom, string $config): array
{
    if ($filesFrom !== null) {
        $content = @file_get_contents($filesFrom);
        if ($content === false) {
            shardFail("cannot read {$filesFrom}");
        }
        $lines = explode("\n", $content);
    } else {
        $listing = tempnam(sys_get_temp_dir(), 'knossos-phpunit-tests-');
        if ($listing === false) {
            shardFail('cannot create a temporary file for the test listing');
        }
        $output = [];
        $status = 0;
        exec(escapeshellarg(PHP_BINARY) . ' ' . escapeshellarg($root . '/vendor/bin/phpunit')
            . ' -c ' . escapeshellarg($config) . ' --list-tests-xml ' . escapeshellarg($listing) . ' 2>&1', $output, $status);
        $document = new DOMDocument();
        $loaded = $status === 0 && @$document->load($listing);
        @unlink($listing);
        if (!$loaded) {
            shardFail("vendor/bin/phpunit --list-tests-xml failed:\n" . implode("\n", $output));
        }
        $lines = [];
        foreach ($document->getElementsByTagName('testClass') as $class) {
            if ($class->getElementsByTagName('testMethod')->length > 0) {
                $lines[] = $class->getAttribute('file');
            }
        }
    }

    $files = [];
    foreach ($lines as $line) {
        $line = trim($line);
        if ($line === '') {
            continue;
        }
        $files[str_starts_with($line, $root . '/') ? substr($line, strlen($root) + 1) : $line] = true;
    }
    $files = array_keys($files);
    usort($files, strcmp(...));
    if ($files === []) {
        shardFail('no test files to shard');
    }

    return $files;
}

/**
 * Each file's shard: heaviest first, each to the least loaded shard.
 *
 * Weights are compared as whole tenths of a second, so the result does not
 * hinge on floating-point rounding.
 *
 * @param list<string> $files sorted by name
 *
 * @return array<string, int> file => shard, in the order of $files
 */
function shardAssign(array $files, ?string $weightsFrom, int $of): array
{
    $known = [];
    if ($weightsFrom !== null && is_file($weightsFrom)) {
        $decoded = json_decode((string) file_get_contents($weightsFrom), true);
        if (!is_array($decoded)) {
            shardFail("{$weightsFrom} is not a JSON object of file weights");
        }
        foreach ($decoded as $file => $seconds) {
            if (!is_string($file) || (!is_int($seconds) && !is_float($seconds)) || $seconds < 0) {
                shardFail("{$weightsFrom} has a weight that is not a number of seconds");
            }
            $known[$file] = (int) round($seconds * 10);
        }
    }
    // A weight for a file the suite no longer has (renamed or deleted since
    // the weights were measured) is left out, so it neither fails the run nor
    // moves the median the files it does not know are given.
    $stale = array_diff_key($known, array_flip($files));
    if ($stale !== []) {
        fwrite(STDERR, sprintf("phpunit-shard: ignoring %d weight(s) for files the suite does not have; regenerate the weights with --weigh\n", count($stale)));
    }
    $known = array_intersect_key($known, array_flip($files));
    $sortedKnown = array_values($known);
    sort($sortedKnown);
    $median = $sortedKnown === [] ? 1 : $sortedKnown[intdiv(count($sortedKnown), 2)];

    $weights = [];
    foreach ($files as $file) {
        $weights[$file] = $known[$file] ?? $median;
    }
    $order = $files;
    usort($order, static fn(string $a, string $b): int => [$weights[$b], $a] <=> [$weights[$a], $b]);
    $load = array_fill(1, $of, 0);
    $assigned = [];
    foreach ($order as $file) {
        $target = 1;
        foreach ($load as $index => $total) {
            if ($total < $load[$target]) {
                $target = $index;
            }
        }
        $load[$target] += $weights[$file];
        $assigned[$file] = $target;
    }

    $ordered = [];
    foreach ($files as $file) {
        $ordered[$file] = $assigned[$file];
    }

    return $ordered;
}

$files = shardTestFiles($root, $filesFrom, $config);
$of = $list ?? $count;
$assignment = shardAssign($files, $weightsFrom, $of);

if ($list !== null) {
    foreach ($assignment as $file => $index) {
        printf("%s\t%d\n", $file, $index);
    }
    exit(0);
}

$selected = array_keys(array_filter($assignment, static fn(int $index): bool => $index === $shard));

$base = dirname((string) realpath($config));
$absolute = static fn(string $path): string => str_starts_with($path, '/') ? $path : $base . '/' . $path;

$document = new DOMDocument();
$document->preserveWhiteSpace = false;
$document->formatOutput = true;
if (!@$document->load($config)) {
    shardFail("cannot read {$config}");
}
$phpunit = $document->documentElement;
if (!$phpunit instanceof DOMElement) {
    shardFail('phpunit.xml has no root element');
}
foreach (['bootstrap', 'cacheDirectory'] as $attribute) {
    if ($phpunit->hasAttribute($attribute)) {
        $phpunit->setAttribute($attribute, $absolute($phpunit->getAttribute($attribute)));
    }
}
$schema = 'http://www.w3.org/2001/XMLSchema-instance';
if ($phpunit->hasAttributeNS($schema, 'noNamespaceSchemaLocation')) {
    $phpunit->setAttributeNS($schema, 'xsi:noNamespaceSchemaLocation', $absolute($phpunit->getAttributeNS($schema, 'noNamespaceSchemaLocation')));
}
$xpath = new DOMXPath($document);
foreach ($xpath->query('/phpunit/source//directory | /phpunit/source//file') ?: [] as $path) {
    $path->textContent = $absolute(trim($path->textContent));
}

$suites = $xpath->query('/phpunit/testsuites')?->item(0);
if (!$suites instanceof DOMElement) {
    shardFail('phpunit.xml has no <testsuites>');
}
while ($suites->firstChild !== null) {
    $suites->removeChild($suites->firstChild);
}
$suite = $document->createElement('testsuite');
$suite->setAttribute('name', "knossos-shard-{$shard}-of-{$of}");
foreach ($selected as $file) {
    $suite->appendChild($document->createElement('file'))->textContent = $root . '/' . $file;
}
$suites->appendChild($suite);

if (@$document->save($out) === false) {
    shardFail("cannot write {$out}");
}
