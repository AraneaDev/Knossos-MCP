{
  // Mutation testing over all of src. The PHPUnit suite (composer test) now
  // drives every language through one runner, so Infection can reach the full
  // source tree. A full run takes ~80 minutes, so it is not part of any
  // tools/quality profile; .github/workflows/mutation.yml runs it on demand.
  $schema: "vendor/infection/infection/resources/schema.json",
  // Infection applies this limit to EVERY test-suite process it spawns —
  // including the *initial* (coverage) run, not just per-mutant runs. Verified
  // by setting it to 2: the initial run is killed with SIGTERM and Infection
  // reports "PHPUnit reported an exit code of 143" under the misleading
  // "Project tests must be in a passing state" banner.
  //
  // The full PHPUnit suite under PCOV takes ~38s wall-clock (1796 tests,
  // measured 2026-07-25), so the previous value of 25 was below the floor the
  // initial run needs. Per-mutant runs only execute the tests covering the
  // mutated line and stay far below this ceiling; the headroom exists for the
  // initial full run. Re-check if the suite's wall-clock grows again.
  timeout: 120,
  threads: 4,
  source: {
    directories: ["src"],
  },
  // Weed out mutants that cannot be killed except by a test worth less than it
  // costs. Kept narrow on purpose: every exclusion below is justified by a
  // *measured* survivor, not by a hunch about which mutators are noisy.
  //
  // Deliberately NOT excluded: IncrementInteger/DecrementInteger in general. In
  // IgnoreMatcher those mutants sat on index arithmetic (`$i + 1 < $length`) and
  // were genuinely valuable — killing them took the file from 76.69% to 98.54%
  // and exposed a real bug. A blanket exclusion would have hidden that.
  mutators: {
    "@default": true,
    // Integer mutations on a declaration default: byte caps, TTLs, pool sizes.
    // The exact value of `int $maxLineBytes = 1_048_576` is a tuning knob, not
    // behaviour, and it is unobservable through the public API: killing 1048576
    // -> 1048575 needs either a megabyte-sized fixture per assertion or a test
    // that restates the constant. Scoped to declaration defaults so index and
    // offset arithmetic is still mutated.
    IncrementInteger: {
      ignoreSourceCodeByRegex: [
        ".*(?:private|protected|public)[^;{]*int \\$[A-Za-z_]\\w* = \\d[\\d_]{3,}.*",
      ],
    },
    DecrementInteger: {
      ignoreSourceCodeByRegex: [
        ".*(?:private|protected|public)[^;{]*int \\$[A-Za-z_]\\w* = \\d[\\d_]{3,}.*",
      ],
    },
    // Stream buffering hints affect when bytes arrive, never which bytes. Removing
    // `stream_set_read_buffer($input, 0)` was verified by hand to leave the stdio
    // suite entirely green: the read loop still frames every message correctly, it
    // just does so against PHP's default buffer. Killing it would need a test that
    // measures syscall timing, which asserts on the platform rather than on us.
    //
    // Note what is NOT here: fflush(). Dropping a flush is unobservable against a
    // php://temp fixture but deadlocks a real client waiting on a response, so it
    // stays an honest escape rather than a hidden one.
    FunctionCallRemoval: {
      ignoreSourceCodeByRegex: [
        ".*stream_set_(?:read|write|chunk)_buffer\\(.*",
      ],
    },
  },
  logs: {
    text: "coverage/infection/infection.log",
    summary: "coverage/infection/summary.log",
    // Chaos-MCP (which drives Infection for its `audit_code_resilience` tool) reads
    // detailed results from this exact project-root filename, because Infection 0.34+
    // dropped the --logger-json flag it used to pass. Keep the name as-is or that
    // integration breaks; the file itself is generated output and is gitignored.
    json: "chaos-infection-log.json",
  },
  phpUnit: {
    configDir: ".",
    customPath: "vendor/bin/phpunit",
  },
  testFramework: "phpunit",
  // Pass --do-not-cache-result so Infection's per-mutation PHPUnit
  // invocation does not read the host project's .phpunit.cache, which
  // can otherwise let stale path/class maps through to coverage
  // collection and produce "No line of code was executed during tests"
  // on freshly added files. The canonical PHPUnit 12.5.31 option; the
  // legacy `--no-cache` is rejected. Spelled `testFrameworkExtraArgs`
  // since Infection 0.34: the older `testFrameworkOptions` still
  // validates but is marked deprecated in the vendored schema.
  testFrameworkExtraArgs: "--do-not-cache-result",
  // Floor set from the last FULL-src measurement on 2026-07-20: 8782 mutants,
  // 4640 killed, 4098 escaped, 44 timeouts -> MSI 53.34% in 1h20m. Rounded down
  // to 53 per the migration plan (never set above what was actually measured on
  // the full source tree). Mutation Code Coverage is 100%, so MSI and Covered
  // MSI are the same number here: the escaped mutants are executed by the suite
  // but not asserted against.
  //
  // The floor was previously ratcheted 53 -> 60 -> 65 -> 76 off per-file
  // Infection samples of ~10 files, but no full-src run ever validated those
  // higher numbers, so a full run would have failed the gate. Reverted to the
  // last honestly-measured full-src value (53) until a full-src Infection run
  // lands and justifies raising it. .github/workflows/mutation.yml now runs
  // weekly (plus workflow_dispatch), so this floor is actually exercised and
  // can be ratcheted upward against measured full-src results over time.
  minMsi: 53,
  minCoveredMsi: 53,
  ignoreMsiWithNoMutations: true,
  tmpDir: "coverage/infection/tmp",
}
