# Directory mounted read-only at /workspace. Defaults to the directory you run
# `docker compose` from. PowerShell does not export PWD, so Windows users must
# set this explicitly.
KNOSSOS_SOURCE=/absolute/path/to/project

# Required only by the `http` profile. Use a random secret; never put it in a URL.
KNOSSOS_HTTP_BEARER_TOKEN=replace-with-a-random-secret

# Native (non-container) use only: the directory holding the graph database and
# roots.json. `tools/install` defaults it to ~/.knossos and pins it into the MCP
# registration it writes. Set the same value in any shell you run `knossos` from,
# or the CLI falls back to `<cwd>/.knossos` and builds a second graph that
# disagrees with the one the server answers from. Compose sets its own /data and
# ignores this.
KNOSSOS_DATA_DIR=/absolute/path/to/knossos-data
