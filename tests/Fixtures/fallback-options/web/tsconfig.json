{
  "compilerOptions": {
    "strict": true,
    "composite": true,
    "noUncheckedIndexedAccess": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "rootDir": "src",
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "src/*"
      ]
    },
    "outDir": "./dist"
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "./tsconfig.shared.json"
    }
  ]
}
