{
  "name": "knossos-mcp-quality",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "eslint workers/typescript/bin workers/typescript/src hooks",
    "format:check": "prettier --check \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "format:write": "prettier --write \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "lint:md": "markdownlint-cli2 \"**/*.md\" \"#vendor/**\" \"#node_modules/**\" \"#workers/**/vendor/**\" \"#workers/**/node_modules/**\"",
    "test:mod": "vitest run --config vitest.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "c8": "11.0.0",
    "eslint": "latest",
    "markdownlint-cli2": "0.23.3",
    "prettier": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "engines": {
    "node": ">=24"
  }
}
