{
  "name": "knossos-quality",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "eslint workers/typescript/bin workers/typescript/src hooks tools/lint-md.mjs tools/lint-md.spec.mjs tools/capture",
    "format:check": "prettier --check \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "format:write": "prettier --write \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "lint:md": "node tools/lint-md.mjs",
    "test:mod": "vitest run --config vitest.config.mjs",
    "typecheck:mod": "tsc -p hooks/tsconfig.json && tsc -p hooks/tsconfig.spec.json"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^24.19.1",
    "@vitest/coverage-v8": "4.1.11",
    "@xterm/xterm": "6.0.0",
    "c8": "11.0.0",
    "eslint": "10.7.0",
    "markdownlint": "0.41.1",
    "prettier": "3.9.5",
    "puppeteer-core": "25.12.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "engines": {
    "node": ">=24"
  }
}
