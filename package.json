{
  "name": "knossos-mcp-quality",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "lint:js": "eslint workers/typescript/bin workers/typescript/src hooks tools/lint-md.mjs tools/lint-md.spec.mjs",
    "format:check": "prettier --check \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "format:write": "prettier --write \"**/*.{js,json,jsonc,yaml,yml,md}\"",
    "lint:md": "node tools/lint-md.mjs",
    "test:mod": "vitest run --config vitest.config.mjs"
  },
  "devDependencies": {
    "@eslint/js": "latest",
    "@types/node": "^24.19.1",
    "c8": "11.0.0",
    "eslint": "latest",
    "markdownlint": "0.41.1",
    "prettier": "latest",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12"
  },
  "engines": {
    "node": ">=24"
  }
}
